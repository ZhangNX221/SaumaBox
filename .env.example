# ==========================================
# 🎮 SaumaBox — Environment Configuration
# ==========================================

# Port web server (default: 3088)
PORT=3088

# Host binding (0.0.0.0 untuk Docker / VPS, 127.0.0.1 untuk localhost ketat)
HOST=0.0.0.0

# Node Environment (production / development)
NODE_ENV=production

# Lokasi penyimpanan database SQLite & backups (default: ./data)
DATA_DIR=./data

# Opsi kustom path database spesifik (opsional)
# DB_PATH=./data/saumabox.sqlite
